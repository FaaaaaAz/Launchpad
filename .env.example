# Copia este archivo a `.env` y rellena los dos valores.
#
#   cp .env.example .env
#
# `.env` esta en .gitignore y NO debe subirse nunca al repositorio.
# Despues de cambiarlo hay que reiniciar Metro: las variables EXPO_PUBLIC_* se
# incrustan en el bundle al compilar, no se leen en caliente.
#
#   npx expo start --clear
#
# Donde salen los dos valores:
#   Supabase -> tu proyecto -> Project Settings -> API Keys
#
# Ambos son PUBLICOS por diseno: viajan dentro de la app y cualquiera puede
# extraerlos del binario. Lo que protege los datos no es esconder la clave,
# es Row Level Security (ver supabase/migrations/*_row_level_security.sql).

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# La clave "publishable" (empieza por `sb_publishable_...`).
# Si tu proyecto todavia usa el formato anterior, pega aqui la clave `anon`
# (un JWT largo que empieza por `eyJ...`): ambas funcionan.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA pongas aqui la `service_role` / `secret key`. Esa clave se salta Row
# Level Security por completo: dentro de una app movil equivale a publicar la
# base de datos entera.
